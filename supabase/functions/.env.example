# Edge-function settings for LOCAL testing with the Supabase CLI (mock providers, no real messages or money).
# Copy to supabase/functions/.env and run:  supabase functions serve --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the CLI – do not set them here.
# Never copy these values to a hosted project.

# Payments: built-in mock gateway (test cards only)
PAYMENTS_ALLOW_MOCK=true
MOCK_GATEWAY_SECRET=local-mock-gateway-secret
MOCK_WEBHOOK_SECRET=local-mock-webhook-secret
MOCK_SEND_WEBHOOKS=true

# Notifications and integrations: recorded in the outbox, nothing is sent
NOTIFY_PROVIDER=mock
INTEGRATIONS_PROVIDER=mock
STAFF_INVITE_MODE=link

# Video: free public Jitsi rooms (no LiveKit server needed)
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

# Links in prescription PDFs / QR codes point at the local app
PUBLIC_APP_URL=http://localhost:5173
