# Copy to .env.mobile for `npm run mobile:build`. Everything here is compiled into the app and is public.
VITE_APP_MODE=supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# Not used inside the app (native push goes through FCM); harmless if set.
VITE_VAPID_PUBLIC_KEY=
