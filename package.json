{
  "name": "sunrise-care-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sunrise Care Connect \u2013 foundation: design system, shell, auth (demo), routing, i18n",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p supabase/functions/tsconfig.json",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n-check.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:test": "bash scripts/db-test.sh",
    "stack:up": "bash scripts/local-stack/up.sh",
    "stack:down": "bash scripts/local-stack/down.sh",
    "e2e:patient": "node scripts/e2e-patient.mjs",
    "e2e:payments": "node scripts/e2e-payments-ui.mjs",
    "e2e:payments-api": "node scripts/e2e-payments-api.mjs",
    "e2e:doctor": "node scripts/e2e-doctor.mjs",
    "e2e:video": "node scripts/e2e-video.mjs",
    "e2e:prescription": "node scripts/e2e-prescription.mjs",
    "e2e:notifications": "node scripts/e2e-notifications.mjs",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "mobile:build": "node scripts/mobile/check-env.mjs && tsc -b && vite build --mode mobile && cap sync && node scripts/mobile/patch-native.mjs",
    "mobile:add": "node scripts/mobile/check-env.mjs && tsc -b && vite build --mode mobile && (test -d android || cap add android) && (test -d ios || cap add ios) && node scripts/mobile/patch-native.mjs",
    "mobile:assets": "npx --yes @capacitor/assets@3.0.5 generate --iconBackgroundColor \"#0F766E\" --splashBackgroundColor \"#0F766E\" --splashBackgroundColorDark \"#0B1220\"",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "e2e:integrations": "node scripts/e2e-integrations.mjs",
    "e2e:pwa": "node scripts/e2e-pwa.mjs",
    "e2e:security": "node scripts/e2e-security.mjs",
    "e2e:journeys": "node scripts/e2e-journeys.mjs",
    "a11y": "node scripts/a11y.mjs",
    "perf": "node scripts/perf-mobile.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^23.16.8",
    "livekit-client": "^2.6.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.0",
    "jsdom": "^25.0.1",
    "jsqr": "1.4.0",
    "lighthouse": "^12.8.2",
    "pg": "^8.13.1",
    "playwright-core": "^1.49.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.18.0"
  }
}
