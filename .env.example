# VITE_APP_ENV says what this build IS (required, no default): demo | production.
#   demo       = may contain demo code, demo logins and test payments
#   production = real auth only; demo mode and demo hints are refused at startup, and `npm run check:bundle` proves demo code is absent
VITE_APP_ENV=demo
# VITE_APP_MODE (required, no default):
# demo     = mock OTP 123456, in-browser session, no database (UI shell only)
# supabase = real Supabase Auth + Postgres + Storage (`npm run stack:up` writes .env.local for the local stack)
VITE_APP_MODE=demo
# Leave empty to use the same origin (Vite proxies /auth/v1, /rest/v1, /storage/v1 in dev and preview)
VITE_SUPABASE_URL=
# Public anon key – RLS protects the data. NEVER put the service-role key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=
# Show the demo logins on the sign-in screen (only for stacks seeded with test OTP numbers)
VITE_DEMO_HINTS=false
